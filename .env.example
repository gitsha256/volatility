# Copy to .env and fill in locally. Never commit .env or real credentials.
FYERS_CLIENT_ID=
FYERS_ACCESS_TOKEN=
FYERS_NIFTY_FUTURES_SYMBOL=
# Used for login and automatic token renewal; never sent with market-data requests.
FYERS_APP_SECRET=
FYERS_REFRESH_TOKEN=
# FYERS account PIN, needed by the refresh-token endpoint. Keep private.
FYERS_PIN=
# Opt in to internal TOTP login endpoints with totp; browser uses interactive sign-in.
FYERS_AUTH_MODE=browser
# Your account login ID, not the API App ID.
FYERS_USERNAME=
# Base32 setup secret from External 2FA TOTP, not a current six-digit code.
FYERS_TOTP_SECRET=
# Must match the redirect URI registered for your FYERS app.
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# Upstox documented TOTP login (enable TOTP in your Upstox account first).
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
# Six-digit Upstox PIN, including any leading zeros.
UPSTOX_PIN=
# Base32 authenticator setup secret, not the current six-digit code.
UPSTOX_TOTP_SECRET=

# Optional Upstox browser OAuth configuration (not needed for TOTP).
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=
# Live Algo app. Kept separate from market and sandbox credentials.
UPSTOX_ALGO_ACCESS_TOKEN=
UPSTOX_ALGO_API_KEY=
UPSTOX_ALGO_API_SECRET=
UPSTOX_ALGO_REDIRECT_URI=
# Optional account-specific values; otherwise shared UPSTOX_PIN/TOTP_SECRET are used.
UPSTOX_ALGO_PIN=
UPSTOX_ALGO_TOTP_SECRET=
# Sandbox token is generated in Developer Apps; sandbox has no TOTP/WebSocket service.
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_API_KEY=
UPSTOX_SANDBOX_API_SECRET=
